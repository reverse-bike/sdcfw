---
import { render } from "astro:content";
import type { PublishedFirmware } from "../lib/publishedFirmware";

interface Props {
  firmware: PublishedFirmware;
  prominentDownload: boolean;
}

const { firmware, prominentDownload } = Astro.props;
const { Content } = await render(firmware.entry);
const fw = firmware.data;
---

<article
  id={fw.anchor}
  class="scroll-mt-4 overflow-hidden rounded-lg border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900"
>
  <div class="p-4">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
      <div class="min-w-0">
        <div class="flex flex-wrap items-center gap-2">
          <h3 class="text-lg font-semibold">{fw.name}</h3>
          <a
            href={`#${fw.anchor}`}
            class="font-mono text-sm text-gray-400 hover:text-blue-500"
            aria-label={`Link to ${fw.name}`}
            title="Link to this release"
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="size-4"
              aria-hidden="true"
            >
              <path d="M10 13a5 5 0 0 0 7.07.07l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" />
              <path d="M14 11a5 5 0 0 0-7.07-.07l-3 3A5 5 0 0 0 11 21l1.71-1.71" />
            </svg>
          </a>
          <span class="text-sm text-gray-500">Release <span class="font-mono">v{fw.version}</span></span>
          {firmware.manifest.target === "controller" && (
            <span class="text-sm text-gray-500">
              Reports <span class="font-mono">{firmware.manifest.provides.controllerVersion}</span>
            </span>
          )}
          {firmware.manifest.target === "nrf" && (
            <span class="text-sm text-gray-500">
              Reports <span class="font-mono">{firmware.manifest.provides.nrfVersion}</span>
            </span>
          )}
          {fw.stock && (
            <span class="rounded bg-gray-100 dark:bg-gray-800 px-2 py-0.5 text-xs font-medium text-gray-700 dark:text-gray-300">
              Factory
            </span>
          )}
          {fw.experimental && (
            <span class="rounded bg-orange-100 dark:bg-orange-950 px-2 py-0.5 text-xs font-medium text-orange-800 dark:text-orange-200">
              Experimental
            </span>
          )}
        </div>
        <p class="mt-0.5 text-sm text-gray-600 dark:text-gray-400">{fw.description}</p>
      </div>
      <a
        href={fw.path}
        download
        class:list={[
          "shrink-0 self-start rounded px-3 py-1.5 text-sm transition-colors",
          prominentDownload
            ? "bg-blue-500 text-white hover:bg-blue-600"
            : "border border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-800",
        ]}
      >
        Download
      </a>
    </div>

    <details class="group mt-3 border-t border-gray-100 dark:border-gray-800 pt-3">
      <summary class="flex w-fit cursor-pointer list-none items-center gap-1 text-sm font-medium text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-gray-100 [&::-webkit-details-marker]:hidden">
        <svg
          viewBox="0 0 20 20"
          fill="currentColor"
          class="size-4 transition-transform group-open:rotate-90"
          aria-hidden="true"
        >
          <path
            fill-rule="evenodd"
            d="M7.22 14.53a.75.75 0 0 1 0-1.06L10.69 10 7.22 6.53a.75.75 0 0 1 1.06-1.06l4 4a.75.75 0 0 1 0 1.06l-4 4a.75.75 0 0 1-1.06 0Z"
            clip-rule="evenodd"
          />
        </svg>
        Release details
      </summary>

      <dl class="mt-3 flex flex-wrap gap-x-6 gap-y-1 text-sm text-gray-500">
        <div class="flex gap-1">
          <dt>Released</dt>
          <dd class="text-gray-700 dark:text-gray-300">{fw.date.toLocaleDateString()}</dd>
        </div>
        {fw.requires && (
          <div class="flex gap-1">
            <dt>Fits controller</dt>
            <dd class="font-mono text-gray-700 dark:text-gray-300">
              {fw.requires.controllerVersion.join(", ")}
            </dd>
          </div>
        )}
        {fw.compatibility && fw.compatibility.length > 0 && (
          <div class="flex gap-1">
            <dt>Models</dt>
            <dd class="text-gray-700 dark:text-gray-300">{fw.compatibility.join(", ")}</dd>
          </div>
        )}
      </dl>

      <div class="prose prose-sm dark:prose-invert mt-4 max-w-none prose-headings:text-base prose-headings:text-gray-900 dark:prose-headings:text-gray-100 prose-p:text-gray-600 dark:prose-p:text-gray-400 prose-li:text-gray-600 dark:prose-li:text-gray-400 prose-strong:text-gray-900 dark:prose-strong:text-gray-100">
        <Content />
      </div>
    </details>
  </div>
</article>
