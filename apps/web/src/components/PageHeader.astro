---
interface Link {
	href: string;
	label: string;
}

interface Props {
	title: string;
	lead?: string | undefined;
	/** Where this page sits in the site, shown as a back link */
	back?: Link | undefined;
	/** Related pages, shown as a row beneath the lead */
	links?: Link[] | undefined;
}

const { title, lead, back, links = [] } = Astro.props;
---

<header class="mb-8">
	{
		back && (
			<a href={back.href} class="text-sm text-blue-500 hover:underline">
				&larr; {back.label}
			</a>
		)
	}
	<h1 class:list={['text-4xl font-bold', back ? 'mt-4' : '']}>{title}</h1>
	{lead && <p class="mt-4 text-xl text-gray-600">{lead}</p>}
	{
		links.length > 0 && (
			<nav class="mt-4 flex flex-wrap gap-6 text-sm">
				{links.map((link) => (
					<a href={link.href} class="text-blue-500 hover:underline">
						{link.label}
					</a>
				))}
			</nav>
		)
	}
</header>
