---
import Page from "../layouts/Page.astro";
import { getCollection, type CollectionEntry } from "astro:content";
import Callout from "../components/Callout";
import FirmwareReleaseCard from "../components/FirmwareReleaseCard.astro";
import {
    readPublishedFirmware,
    type PublishedFirmware,
} from "../lib/publishedFirmware";

type FirmwareFamily = CollectionEntry<"firmwareFamilies">;

const [content, families] = await Promise.all([
    getCollection("firmware", ({ id }) => !id.startsWith("_")),
    getCollection("firmwareFamilies"),
]);
const all = await Promise.all(content.map(readPublishedFirmware));
const familyById = new Map(families.map((family) => [family.id, family]));

/** Compare versions numerically, so 1.10.0 sorts above 1.9.0. */
function compareVersions(a: string, b: string): number {
    const parts = (version: string) =>
        version
            .split(/[^0-9]+/)
            .filter(Boolean)
            .map(Number);
    const [left, right] = [parts(a), parts(b)];
    for (let index = 0; index < Math.max(left.length, right.length); index++) {
        const difference = (left[index] ?? 0) - (right[index] ?? 0);
        if (difference !== 0) return difference;
    }
    return 0;
}

/**
 * Keep only the newest release of each stable family/variant identity.
 */
function latestOnly(entries: PublishedFirmware[]): PublishedFirmware[] {
    const newest = new Map<string, PublishedFirmware>();
    for (const entry of entries) {
        const identity = `${entry.data.family}/${entry.data.variant}`;
        const current = newest.get(identity);
        const isNewer =
            !current ||
            compareVersions(entry.data.version, current.data.version) > 0 ||
            (compareVersions(entry.data.version, current.data.version) === 0 &&
                entry.data.date.getTime() > current.data.date.getTime());
        if (isNewer) newest.set(identity, entry);
    }
    return [...newest.values()];
}

/** Custom releases first, newest first; the factory image last. */
function forDisplay(entries: PublishedFirmware[]): PublishedFirmware[] {
    return latestOnly(entries).sort((a, b) => {
        if (a.data.stock !== b.data.stock) return a.data.stock ? 1 : -1;
        return b.data.date.getTime() - a.data.date.getTime();
    });
}

interface FirmwareGroup {
    id: string;
    family: FirmwareFamily;
    entries: PublishedFirmware[];
}

function groupByFamily(entries: PublishedFirmware[]): FirmwareGroup[] {
    const groups = new Map<string, FirmwareGroup>();
    for (const entry of forDisplay(entries)) {
        const family = familyById.get(entry.data.family);
        if (!family)
            throw new Error(
                `${entry.entry.id}: unknown firmware family ${entry.data.family}`,
            );
        if (family.data.target !== entry.data.target) {
            throw new Error(
                `${entry.entry.id}: ${entry.data.target} archive belongs to ${family.data.target} family ${family.id}`,
            );
        }
        const group = groups.get(family.id) ?? {
            id: family.id,
            family,
            entries: [],
        };
        group.entries.push(entry);
        groups.set(family.id, group);
    }
    return [...groups.values()];
}

const controller = groupByFamily(
    all.filter((entry) => entry.data.target === "controller"),
);
const display = groupByFamily(
    all.filter((entry) => entry.data.target === "nrf"),
);

const sections = [
    {
        id: "controller",
        title: "Motor controller",
        blurb: "Changes how the bike delivers power. Flashed over Bluetooth, with no cable and nothing to take apart.",
        guide: {
            href: "/controller",
            label: "Open the motor controller guide",
        },
        instructions:
            "You do not need to download anything. The guide reads your bike, offers the releases that fit it, and fetches the package for you. Downloads are here for people who want to inspect a package or flash it using the manual file selector.",
        groups: controller,
    },
    {
        id: "display",
        title: "Display",
        blurb: "Changes the display module itself. Flashed over USB, which means opening the case and wiring a debug probe.",
        guide: { href: "/display", label: "Open the display guide" },
        instructions:
            "Download the package you want, then follow the guide. It walks you through backing up your original firmware first, and takes the downloaded file in its Restore step.",
        groups: display,
    },
];
---

<Page
    title="Firmware"
    lead="Every firmware release we publish, and what each one changes. Only the newest version of each is listed."
    back={{ href: "/", label: "Back to home" }}
>
    <div class="mb-10">
        <Callout type="warning" title="Before you flash anything">
            Custom firmware is provided as-is, will likely void your warranty,
            and may affect compliance with local regulations. Display firmware
            can be backed up first and the guide walks you through it. Motor
            controller firmware cannot be read off the bike at all, so the
            factory image published below is the only way back.
        </Callout>
    </div>

    {
        sections.map((section) => (
            <section class="mb-14" id={section.id}>
                <div class="mb-5 border-b border-gray-200 pb-4">
                    <h2 class="text-2xl font-bold">{section.title}</h2>
                    <p class="mt-1 text-gray-600">{section.blurb}</p>
                    <p class="mt-3 text-sm text-gray-600">
                        {section.instructions}
                    </p>
                    <a
                        href={section.guide.href}
                        class="mt-3 inline-block font-medium text-blue-500 hover:underline"
                    >
                        {section.guide.label} &rarr;
                    </a>
                </div>

                {section.groups.length === 0 ? (
                    <p class="text-gray-500">No releases published yet.</p>
                ) : (
                    <div class="space-y-4">
                        {section.groups.map((group) => (
                            <div class="rounded-xl border border-gray-200 bg-gray-50 p-4">
                                <header class="mb-4">
                                    <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                                        <h3 class="text-xl font-semibold">
                                            {group.family.data.name}
                                        </h3>
                                        <span class="font-mono text-sm text-gray-500">
                                            Factory reports{" "}
                                            {group.family.data.factoryVersion}
                                        </span>
                                    </div>
                                    <p class="mt-1 text-sm text-gray-600">
                                        {group.family.data.description}
                                    </p>
                                    <div class="mt-2 flex flex-wrap gap-x-5 gap-y-1 text-xs text-gray-500">
                                        {group.family.data.requires && (
                                            <span>
                                                Fits controller versions{" "}
                                                <span class="font-mono text-gray-700">
                                                    {group.family.data.requires.controllerVersion.join(
                                                        ", ",
                                                    )}
                                                </span>
                                            </span>
                                        )}
                                        {group.family.data.compatibility && (
                                            <span>
                                                Models{" "}
                                                <span class="text-gray-700">
                                                    {group.family.data.compatibility.join(
                                                        ", ",
                                                    )}
                                                </span>
                                            </span>
                                        )}
                                    </div>
                                </header>
                                <div class="space-y-3">
                                    {group.entries.map((firmware) => (
                                        <FirmwareReleaseCard
                                            firmware={firmware}
                                            prominentDownload={
                                                section.id === "display"
                                            }
                                        />
                                    ))}
                                </div>
                            </div>
                        ))}
                    </div>
                )}
            </section>
        ))
    }

    <section>
        <div
            class="rounded-lg border border-gray-200 bg-gray-50 p-6 text-center"
        >
            <h2 class="mb-2 text-xl font-semibold">Stay updated</h2>
            <p class="mb-4 text-gray-600">
                New releases are announced in the community Discord.
            </p>
            <a
                href="https://discord.gg/STvgARZYaw"
                target="_blank"
                rel="noopener"
                class="inline-block rounded bg-blue-500 px-6 py-2 text-white transition-colors hover:bg-blue-600"
            >
                Join the Discord
            </a>
        </div>
    </section>
</Page>
