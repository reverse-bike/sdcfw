---
import Page from '../layouts/Page.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Callout from '../components/Callout';

type Firmware = CollectionEntry<'firmware'>;

const all = await getCollection('firmware', ({ id }) => !id.startsWith('_'));

/** Compare versions numerically, so 1.10.0 sorts above 1.9.0. */
function compareVersions(a: string, b: string): number {
	const parts = (version: string) => version.split(/[^0-9]+/).filter(Boolean).map(Number);
	const [left, right] = [parts(a), parts(b)];
	for (let index = 0; index < Math.max(left.length, right.length); index++) {
		const difference = (left[index] ?? 0) - (right[index] ?? 0);
		if (difference !== 0) return difference;
	}
	return 0;
}

/**
 * Keep only the newest release of each firmware, keyed on its name. Older
 * versions stay in the repository; this page is about what to install today.
 */
function latestOnly(entries: Firmware[]): Firmware[] {
	const newest = new Map<string, Firmware>();
	for (const entry of entries) {
		const current = newest.get(entry.data.name);
		const isNewer =
			!current ||
			compareVersions(entry.data.version, current.data.version) > 0 ||
			(compareVersions(entry.data.version, current.data.version) === 0 &&
				entry.data.date.getTime() > current.data.date.getTime());
		if (isNewer) newest.set(entry.data.name, entry);
	}
	return [...newest.values()];
}

/** Custom releases first, newest first; the factory image last. */
function forDisplay(entries: Firmware[]): Firmware[] {
	return latestOnly(entries).sort((a, b) => {
		if (a.data.stock !== b.data.stock) return a.data.stock ? 1 : -1;
		return b.data.date.getTime() - a.data.date.getTime();
	});
}

const controller = forDisplay(all.filter((entry) => entry.data.target === 'controller'));
const display = forDisplay(all.filter((entry) => entry.data.target === 'nrf'));

const sections = [
	{
		id: 'controller',
		title: 'Motor controller',
		blurb:
			'Changes how the bike delivers power. Flashed over Bluetooth, with no cable and nothing to take apart.',
		guide: { href: '/controller', label: 'Open the motor controller guide' },
		instructions:
			'You do not need to download anything. The guide reads your bike, offers the releases that fit it, and fetches the package for you. Downloads are here for people who want to inspect a package or flash it with the command line tools.',
		entries: controller,
	},
	{
		id: 'display',
		title: 'Display',
		blurb:
			'Changes the display module itself. Flashed over USB, which means opening the case and wiring a debug probe.',
		guide: { href: '/display', label: 'Open the display guide' },
		instructions:
			'Download the package you want, then follow the guide. It walks you through backing up your original firmware first, and takes the downloaded file in its Restore step.',
		entries: display,
	},
];
---

<Page
	title="Firmware"
	lead="Every firmware release we publish, and what each one changes. Only the newest version of each is listed."
	back={{ href: '/', label: 'Back to home' }}
>

		<div class="mb-10">
			<Callout type="warning" title="Before you flash anything">
				Custom firmware is provided as-is, will likely void your warranty, and may affect
				compliance with local regulations. Display firmware can be backed up first and the guide
				walks you through it. Motor controller firmware cannot be read off the bike at all, so the
				factory image published below is the only way back.
			</Callout>
		</div>

		{sections.map((section) => (
			<section class="mb-14" id={section.id}>
				<div class="mb-5 border-b border-gray-200 pb-4">
					<h2 class="text-2xl font-bold">{section.title}</h2>
					<p class="mt-1 text-gray-600">{section.blurb}</p>
					<p class="mt-3 text-sm text-gray-600">{section.instructions}</p>
					<a
						href={section.guide.href}
						class="mt-3 inline-block font-medium text-blue-500 hover:underline"
					>
						{section.guide.label} &rarr;
					</a>
				</div>

				{section.entries.length === 0 ? (
					<p class="text-gray-500">No releases published yet.</p>
				) : (
					<div class="space-y-6">
						{section.entries.map(async (fw) => {
							const { Content } = await render(fw);
							return (
								<article
									id={fw.id}
									class="scroll-mt-4 overflow-hidden rounded-lg border border-gray-200 bg-white"
								>
									<div class="p-6">
										<div class="mb-4 flex items-start justify-between gap-4">
										<div>
											<div class="flex flex-wrap items-center gap-2">
												<h3 class="text-xl font-semibold">{fw.data.name}</h3>
												<a
													href={`#${fw.id}`}
													class="font-mono text-sm text-gray-400 hover:text-blue-500"
													aria-label={`Link to ${fw.data.name}`}
													title="Link to this release"
												>
													<svg
														viewBox="0 0 24 24"
														fill="none"
														stroke="currentColor"
														stroke-width="2"
														stroke-linecap="round"
														stroke-linejoin="round"
														class="size-4"
														aria-hidden="true"
													>
														<path d="M10 13a5 5 0 0 0 7.07.07l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" />
														<path d="M14 11a5 5 0 0 0-7.07-.07l-3 3A5 5 0 0 0 11 21l1.71-1.71" />
													</svg>
												</a>
												<span class="font-mono text-sm text-gray-500">v{fw.data.version}</span>
													{fw.data.stock && (
														<span class="rounded bg-gray-100 px-2 py-0.5 text-xs font-medium text-gray-700">
															Factory
														</span>
													)}
													{fw.data.experimental && (
														<span class="rounded bg-orange-100 px-2 py-0.5 text-xs font-medium text-orange-800">
															Experimental
														</span>
													)}
												</div>
												<p class="mt-1 text-gray-600">{fw.data.description}</p>
											</div>
											<a
												href={fw.data.path}
												download
												class={`shrink-0 rounded px-4 py-2 transition-colors ${
													section.id === 'display'
														? 'bg-blue-500 text-white hover:bg-blue-600'
														: 'border border-gray-300 text-gray-700 hover:bg-gray-50'
												}`}
											>
												Download
											</a>
										</div>

										<dl class="mb-5 flex flex-wrap gap-x-6 gap-y-1 text-sm text-gray-500">
											<div class="flex gap-1">
												<dt>Released</dt>
												<dd class="text-gray-700">{fw.data.date.toLocaleDateString()}</dd>
											</div>
											{fw.data.requires && (
												<div class="flex gap-1">
													<dt>Fits controller</dt>
													<dd class="font-mono text-gray-700">
														{fw.data.requires.controllerVersion.join(', ')}
													</dd>
												</div>
											)}
											{fw.data.compatibility && fw.data.compatibility.length > 0 && (
												<div class="flex gap-1">
													<dt>Models</dt>
													<dd class="text-gray-700">{fw.data.compatibility.join(', ')}</dd>
												</div>
											)}
										</dl>

										<div class="prose prose-sm max-w-none prose-headings:text-gray-900 prose-headings:text-base prose-p:text-gray-600 prose-li:text-gray-600 prose-strong:text-gray-900">
											<Content />
										</div>
									</div>
								</article>
							);
						})}
					</div>
				)}
			</section>
		))}

		<section>
			<div class="rounded-lg border border-gray-200 bg-gray-50 p-6 text-center">
				<h2 class="mb-2 text-xl font-semibold">Stay updated</h2>
				<p class="mb-4 text-gray-600">
					New releases are announced in the community Discord.
				</p>
				<a
					href="https://discord.gg/STvgARZYaw"
					target="_blank"
					rel="noopener"
					class="inline-block rounded bg-blue-500 px-6 py-2 text-white transition-colors hover:bg-blue-600"
				>
					Join the Discord
				</a>
			</div>
		</section>
	
</Page>
