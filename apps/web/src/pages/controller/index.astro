---
import { getCollection } from "astro:content";
import ControllerGuide from "../../components/ControllerGuide";
import type { FirmwareRelease } from "../../components/controllerFlash";
import Page from "../../layouts/Page.astro";
import {
  firmwareFamilyId,
  readPublishedFirmware,
} from "../../lib/publishedFirmware";

const [content, families] = await Promise.all([
  getCollection("firmware", ({ data }) => !data.downloadOnly),
  getCollection("firmwareFamilies"),
]);
const familyById = new Map(families.map((family) => [firmwareFamilyId(family), family]));
const entries = (await Promise.all(content.map(readPublishedFirmware))).filter(
  (entry) => entry.data.target === "controller",
);

const releases: FirmwareRelease[] = entries
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .map((entry) => {
    const family = familyById.get(entry.data.family);
    const requires = entry.data.requires ?? family?.data.requires;
    return {
      id: entry.data.anchor,
      name: entry.data.name,
      version: entry.data.version,
      description: entry.data.description,
      path: entry.data.path,
      experimental: entry.data.experimental,
      ...(requires ? { requires } : {}),
    };
  });
---

<Page
  title="Motor controller firmware"
  lead="Update your motor controller with a custom build, or put it back to stock. Everything happens over Bluetooth, with no cables and nothing to take apart."
  back={{ href: "/", label: "Back to home" }}
  links={[
    { href: "/controller/advanced", label: "Advanced tools" },
    { href: "/firmware#controller", label: "Custom firmware" },
  ]}
>
  <ControllerGuide client:only="solid-js" releases={releases} />
</Page>
