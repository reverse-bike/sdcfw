---
import McFarmDfu from "../components/McFarmDfu";
import McFarmRead from "../components/McFarmRead";
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <main class="min-h-screen bg-gray-100 px-4 py-10 text-gray-900">
    <div class="mx-auto max-w-2xl">
      <header class="mb-6">
        <p class="mb-1 text-sm font-semibold tracking-wide text-blue-600 uppercase">
          Experimental tools
        </p>
        <h1 class="text-3xl font-bold">Bike Bluetooth tools</h1>
        <p class="mt-2 text-gray-600">
          Bluetooth tools for the motor controller, mirroring the mc-farm CLI. Requires Chrome or
          another Chromium browser.
        </p>
      </header>

      <McFarmRead client:only="solid-js" />
      <McFarmDfu client:only="solid-js" />
    </div>
  </main>
</Layout>
