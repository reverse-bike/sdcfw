---
import Page from '../../layouts/Page.astro';
import AdvancedTools from '../../components/AdvancedTools';
import Callout from '../../components/Callout';
import BootloaderUpdate from '../../components/BootloaderUpdate';
---

<Page
	title="Display tools"
	lead="Bluetooth bootloader updates and individual wired display tools."
	back={{ href: '/display', label: 'Display guide' }}
	links={[{ href: '/firmware#display', label: 'Custom firmware' }]}
>

		<div class="mb-6">
			<Callout type="warning" title="Advanced tools: recovery may require a wired probe">
				These tools do not provide the display guide's backup workflow. The Bluetooth tool
				updates only the nRF bootloader; the wired tools below perform individual operations.
				If you came here to install
				custom display firmware, use the <a href="/display" class="underline">display guide</a> instead.
			</Callout>
		</div>

		<div id="tools-container">
			<BootloaderUpdate client:only="solid-js" />
			<AdvancedTools client:only="solid-js" />
		</div>
	
</Page>
