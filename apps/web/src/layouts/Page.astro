---
import PageHeader from '../components/PageHeader.astro';
import Layout from './Layout.astro';

interface Link {
	href: string;
	label: string;
}

interface Props {
	title?: string | undefined;
	lead?: string | undefined;
	back?: Link | undefined;
	links?: Link[] | undefined;
}

const { title, lead, back, links } = Astro.props;
---

{/* One shell for every page, so widths, padding and heading sizes match. */}
<Layout>
	<div class="container mx-auto max-w-4xl px-4 py-8">
		{title && <PageHeader title={title} lead={lead} back={back} links={links} />}
		<slot />
	</div>
</Layout>
