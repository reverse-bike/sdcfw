{
  "name": "sdcfw",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@types/bun": "^1.2.22",
      "@types/web-bluetooth": "^0.0.21",
      "@astrojs/solid-js": "^7.0.1",
      "@astrojs/check": "^0.9.10",
      "@tailwindcss/typography": "^0.5.20",
      "@tailwindcss/vite": "^4.3.3",
      "@types/node": "^26.1.1",
      "@types/node-hid": "^3.0.0",
      "@types/usb": "^2.0.5",
      "@types/w3c-web-usb": "^1.0.14",
      "astro": "^7.1.6",
      "crc-32": "^1.2.2",
      "eventemitter3": "^5.0.4",
      "fflate": "^0.8.3",
      "node-hid": "^3.3.0",
      "solid-js": "^1.9.14",
      "tailwindcss": "^4.3.3",
      "typescript": "^6",
      "usb": "^2.18.0",
      "webbluetooth": "^3.7.0"
    }
  },
  "type": "module",
  "scripts": {
    "mc-farm": "bun apps/mc-farm/main.ts",
    "nrf-farm": "bun apps/nrf-farm/main.ts",
    "kitchen": "bun apps/kitchen/main.ts",
    "web": "bun run --cwd apps/web dev",
    "web:build": "bun run --cwd apps/web build",
    "web:preview": "bun run --cwd apps/web preview",
    "web:check": "bun run --cwd apps/web astro check",
    "typecheck": "tsc --noEmit && tsc --noEmit --project apps/web/tsconfig.json",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check ."
  },
  "devDependencies": {
    "@sdcfw/kitchen": "workspace:*",
    "@sdcfw/mc-farm": "workspace:*",
    "@sdcfw/nrf-farm": "workspace:*",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.2",
    "@types/w3c-web-usb": "^1.0.14",
    "@types/web-bluetooth": "^0.0.21",
    "eslint-plugin-solid": "^0.14.5",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "typescript": "^6.0.3"
  }
}
