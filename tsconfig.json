{
  "exclude": ["node_modules", "dist", "build", "apps/web/src/content"],
  "compilerOptions": {
    "paths": {
      "@sdcfw/usb-utils": ["./packages/usb-utils/index.ts"],
      "@sdcfw/ble-utils": ["./packages/ble-utils/index.ts"],
      "@sdcfw/dapjs": ["./packages/dapjs/index.ts"],
    },
    // Environment setup & latest features
    "lib": ["ESNext", "dom"],
    "types": ["bun", "node", "web-bluetooth"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "allowJs": false,

    // Bundler mode
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    // JSX setup for SolidJS
    "jsx": "preserve",
    "jsxImportSource": "solid-js",

    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    // Some stricter flags (disabled by default)
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false,
  },
}
